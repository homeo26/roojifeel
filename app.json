{
  "expo": {
    "name": "Roojifeel",
    "slug": "roojifeel",
    "scheme": "roojifeel",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "supportsRTL": true,
      "router": {},
      "eas": {
        "projectId": "c78dbc2c-3b71-4296-8c06-068e1bdad963"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roojifeel.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ExpoLocalization_supportsRTL": true,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "package": "com.roojifeel.app",
      "adaptiveIcon": {
        "backgroundColor": "#010211",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7c3aed"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withArm64Only",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Roojifeel needs photo access so you can attach a picture to a feeling.",
          "cameraPermission": "Roojifeel needs camera access so you can snap a photo for a feeling."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Roojifeel",
              "label": "Roojifeel",
              "description": "Today's mood and one-tap feeling log",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "RoojifeelPinned",
              "label": "Pinned memory",
              "description": "A cherished feeling, kept close",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "RoojifeelWidget",
              "displayName": "Roojifeel",
              "description": "Today's mood and a one-tap feeling log",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            },
            {
              "name": "RoojifeelPinnedWidget",
              "displayName": "Pinned memory",
              "description": "A cherished feeling, kept close",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      "./plugins/withWorkManagerAlignment"
    ],
    "owner": "homeo26s-team"
  }
}
